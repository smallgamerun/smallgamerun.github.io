---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout language="zh" title="404">
  <section class="page-hero section">
    <div class="container narrow">
      <p class="eyebrow"><span class="status-dot"></span>PAGE_NOT_FOUND</p>
      <h1>404</h1>
      <p>这里没有你要找的页面。The signal ends here.</p>
      <a class="button button-primary" href="/">返回首页 <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
