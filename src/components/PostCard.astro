---
import type { CollectionEntry } from "astro:content";
import { copy, type Language } from "../data/site";
import { postPath } from "../lib/content";

const { post, language } = Astro.props as {
  post: CollectionEntry<"blog">;
  language: Language;
};
const t = copy[language];
const date = new Intl.DateTimeFormat(language === "zh" ? "zh-CN" : "en-US", {
  year: "numeric",
  month: language === "zh" ? "numeric" : "short",
  day: "numeric"
}).format(post.data.date);
---

<article class="post-card">
  <div class="post-meta">
    <time datetime={post.data.date.toISOString()}>{date}</time>
    <span>{post.data.tags.join(" · ")}</span>
  </div>
  <h3><a href={postPath(language, post.data.path)}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  <a class="text-link" href={postPath(language, post.data.path)}>{t.readMore}<span aria-hidden="true"> →</span></a>
</article>
